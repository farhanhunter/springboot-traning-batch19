{
  "info": {
    "name": "Batch 19 - Count Character Microservice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Urutan demo: Register -> Login (token otomatis tersimpan) -> Analisis. Semua request lewat gateway :8080."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/gateway"
    },
    {
      "key": "apiKey",
      "value": "123456"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "analysisId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. User & Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "APIKey",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/rest/v1/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "rest",
                "v1",
                "users",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Farhan\",\n  \"lastName\": \"Saputra\",\n  \"email\": \"farhan@mail.com\",\n  \"phoneNumber\": \"08123456789\",\n  \"password\": \"rahasia123\"\n}"
            }
          }
        },
        {
          "name": "Register - validasi gagal (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "APIKey",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/rest/v1/users/register",
              "host": [
                "{{baseUrl}}"
              ],
